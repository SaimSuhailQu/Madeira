diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
index a3be2bc..21fba89 100644
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -122,7 +122,18 @@ _MTLCopyAllDevices(void *obj) {
     params->ret = (wmtr_call(RM_OP_COPY_ALL_DEVICES, 0, 0, &r, sizeof r, 0) == RM_OK) ? r.handle : 0;
     return STATUS_SUCCESS;
   }
+#if TARGET_OS_OSX || TARGET_OS_MACCATALYST
   params->ret = (obj_handle_t)MTLCopyAllDevices();
+#else
+  id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+  if (device) {
+    NSArray *devices = [[NSArray alloc] initWithObjects:device, nil];
+    params->ret = (obj_handle_t)devices;
+    [device release];
+  } else {
+    params->ret = 0;
+  }
+#endif
   return STATUS_SUCCESS;
 }
 
